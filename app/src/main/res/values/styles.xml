<resources>
    <style name="PlannerBaseTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#52699b</item>
        <item name="android:statusBarColor">#03192e</item>
        <item name="android:navigationBarColor">#03192e</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#03192e</item>
    </style>
    <style name="AppTheme" parent="@style/PlannerBaseTheme"/>
    <style name="PlannerIceLaunchTheme" parent="@style/AppTheme"/>
    <style name="PlannerGraphiteLaunchTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">#8d8d8d</item>
        <item name="android:statusBarColor">#8d8d8d</item>
        <item name="android:navigationBarColor">#8d8d8d</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
